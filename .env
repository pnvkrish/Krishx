# ============================================================
# KRISHX Markets — Environment Variables
# Copy this file to .env.local and fill in your credentials
# NEVER commit .env.local to git
# ============================================================

# Supabase — get from https://supabase.com → Project Settings → API
REACT_APP_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
REACT_APP_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Alpha Vantage — free API key from https://www.alphavantage.co/support/#api-key
# Free tier: 5 requests/min, 500/day
REACT_APP_ALPHA_VANTAGE_KEY=YOUR_ALPHA_VANTAGE_KEY
